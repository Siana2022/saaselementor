# Copia este archivo a `.env.local` y rellena los valores.

# Requerida SOLO para el chat de IA (Pilar 4). El resto del SaaS funciona sin ella.
# Obtén una clave en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Opcional: modelo a usar (por defecto: claude-sonnet-5)
# ANTHROPIC_MODEL=claude-sonnet-5
